<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>𝑻𝑰𝑰𝑻𝑰𝑰_𝑩𝒐𝒕 - Dashboard Admin</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-slate-900 text-white font-sans">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="w-64 bg-slate-950 p-6 flex flex-col justify-between border-r border-slate-800">
            <div>
                <h1 class="text-xl font-bold text-indigo-400 mb-8">𝑻𝑰𝑰𝑻𝑰𝑰_𝑩𝒐𝒕 Panel</h1>
                <nav class="space-y-4">
                    <a href="#overview" class="block py-2.5 px-4 rounded bg-indigo-600 text-white font-medium">📊 Vue d'ensemble</a>
                    <a href="#confessions" class="block py-2.5 px-4 rounded hover:bg-slate-800 text-slate-300">🔓 Confessions (MongoDB)</a>
                    <a href="#supabase" class="block py-2.5 px-4 rounded hover:bg-slate-800 text-slate-300">📈 Niveaux (Supabase)</a>
                </nav>
            </div>
            <div class="flex items-center gap-3 border-t border-slate-800 pt-4">
                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" class="w-10 h-10 rounded-full">
                <div>
                    <p class="font-semibold text-sm"><%= user.username %></p>
                    <p class="text-xs text-slate-400">Administrateur</p>
                </div>
            </div>
        </div>

        <!-- Contenu principal -->
        <div class="flex-1 p-10 overflow-y-auto">
            <h2 class="text-3xl font-bold mb-6">Tableau de bord administrateur</h2>

            <!-- Section 1 : Stats du Bot (Idée 1) -->
            <div id="overview" class="grid grid-cols-3 gap-6 mb-10">
                <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
                    <p class="text-slate-400 text-sm">Uptime du Bot</p>
                    <p class="text-3xl font-bold mt-2 text-indigo-400"><%= stats.uptime %> min</p>
                </div>
                <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
                    <p class="text-slate-400 text-sm">Membres totaux</p>
                    <p class="text-3xl font-bold mt-2 text-emerald-400"><%= stats.totalMembers %></p>
                </div>
                <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
                    <p class="text-slate-400 text-sm">Latence WebSocket (Ping)</p>
                    <p class="text-3xl font-bold mt-2 text-amber-400"><%= stats.ping %> ms</p>
                </div>
            </div>

            <!-- Section 3 : Confessions MongoDB (Idée 3) -->
            <div id="confessions" class="bg-slate-800 p-6 rounded-xl border border-slate-700 mb-10">
                <h3 class="text-xl font-bold mb-4 text-indigo-300">🔓 Dernières Confessions (MongoDB)</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-700 text-slate-400 text-sm">
                                <th class="pb-3">Code</th>
                                <th class="pb-3">Contenu</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% confessions.forEach(conf => { %>
                                <tr class="border-b border-slate-700/50 text-sm">
                                    <py class="py-3 font-mono text-indigo-400"><%= conf.code %></py>
                                    <td class="py-3 text-slate-300"><%= conf.content || 'Fichier/Média joint' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Section Supabase (Idée 5 / Données Supabase) -->
            <div id="supabase" class="bg-slate-800 p-6 rounded-xl border border-slate-700">
                <h3 class="text-xl font-bold mb-4 text-emerald-300">📈 Suivi Supabase (Niveaux & Activité)</h3>
                <p class="text-slate-400 text-sm">Données synchronisées en temps réel depuis ta base de données Supabase.</p>
                <!-- Tu pourras lister tes données Supabase ici avec une boucle EJS similaire -->
            </div>
        </div>
    </div>
</body>
</html>
